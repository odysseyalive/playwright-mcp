# Template for ./.env — copy to .env, fill in YOUR values, then `chmod 600 .env`.
# The real .env is gitignored and must never be committed (it holds the secret).
# All server-specific / identifiable values live here and ONLY here.

# --- jstack --install-site contract (parsed by jstack.sh; keep these three first) ---
DOMAIN=mcp.example.com
PORT=8765
CONTAINER=mcp-connector

# --- playwright-mcp remote connector (injected into the container) ---
PLAYWRIGHT_MCP_PUBLIC_URL=https://mcp.example.com
PLAYWRIGHT_MCP_PORT=8765
# 0.0.0.0 is safe ONLY because the port is not host-published; nginx reaches it over
# the docker network by container name. Never set this on a host-published port.
PLAYWRIGHT_MCP_BIND=0.0.0.0

# --- GitHub OAuth (REQUIRED — server fails closed without all three) ---
# Create at: GitHub > Settings > Developer settings > OAuth Apps > New OAuth App
#   Homepage URL:               https://mcp.example.com
#   Authorization callback URL: https://mcp.example.com/oauth/github/callback
GITHUB_CLIENT_ID=Iv1.0123456789abcdef
GITHUB_CLIENT_SECRET=0123456789abcdef0123456789abcdef01234567
GITHUB_ALLOWED_LOGIN=your-github-username
