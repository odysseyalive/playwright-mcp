{
  "name": "@francis/playwright-mcp",
  "version": "0.3.0",
  "description": "User-scoped Playwright MCP server: full @playwright/mcp toolset plus web_fetch (replaces native WebFetch) and session helpers, over stdio; optionally exposes a hardened, GitHub-OAuth'd remote Streamable-HTTP transport for claude.ai custom connectors",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "playwright-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke.mjs",
    "scaffold:e2e": "node scripts/scaffold-e2e.mjs",
    "test": "node --test scripts/test-*.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "gate": "npm run build && npm test && npm run smoke"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@mozilla/readability": "0.6.0",
    "@playwright/mcp": "0.0.75",
    "express": "5.2.1",
    "jsdom": "29.1.1",
    "pdfjs-dist": "6.0.227",
    "playwright": "1.61.0-alpha-1778188671000"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jsdom": "28.0.3",
    "@types/node": "20.19.42",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
