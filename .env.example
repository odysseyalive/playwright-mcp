# playwright-mcp secrets — EXAMPLE
#
# Real secrets live OUTSIDE the repo, at:
#   ~/.config/playwright-mcp/secrets.env          (Linux/macOS)
#   %APPDATA%\playwright-mcp\secrets.env          (Windows)
# (override the path with the PLAYWRIGHT_MCP_SECRETS env var)
#
# Format: KEY=value, one per line, # for comments, optional quotes. The file is
# passed to the wrapped @playwright/mcp server and read by session_login for
# credential filling. Keep it mode 600; it is gitignored — never commit real values.
#
# Credentials for session_login (referenced by credKeys, e.g.
# session_login({ credKeys: { user: "ACME_USER", pass: "ACME_PASS" } })):
ACME_USER=you@example.com
ACME_PASS=replace-me

# Saved authenticated sessions (storageState) are written to, and read from:
#   ~/.config/playwright-mcp/sessions/<name>.json   (mode 600, gitignored)
#   override with PLAYWRIGHT_MCP_SESSIONS
